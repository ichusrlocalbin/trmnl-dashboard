<div class="jp" style="position: relative; width: 100%; height: 100%; padding: 14px 18px; box-sizing: border-box;">
{% if page == "dashboard" %}
  <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 3px solid #000; padding-bottom: 6px;">
    <span class="b" style="font-size: 32px;">10月22日（木）</span>
    <span style="font-size: 18px;">東京 ・ 13:30 更新</span>
  </div>
  <div style="display: flex; gap: 20px; margin-top: 10px;">
    <div style="width: 330px; flex: none; display: flex; flex-direction: column; gap: 6px;">
      <span style="font-size: 20px;">今日</span>
      <span class="b" style="font-size: 48px; line-height: 1;">23° / 14°</span>
      <span style="font-size: 22px;">晴れ 夕方から くもり</span>
      <span style="font-size: 20px;">降水確率 20%</span>
      <span style="font-size: 20px; margin-top: 10px;">明日　19° / 13°　降水 70%</span>
      <span style="font-size: 18px;">雨 昼過ぎから やむ</span>
    </div>
    <div style="flex: 1; display: flex; flex-direction: column; gap: 6px; border-left: 2px solid #000; padding-left: 18px;">
      <span class="b" style="font-size: 22px;">今日の予定</span>
      <span style="font-size: 22px;">終日　有給休暇</span>
      <span style="font-size: 22px;">10:00　定例ミーティング</span>
      <span style="font-size: 22px;">14:30　歯医者（千代田区）</span>
      <span class="b" style="font-size: 22px; margin-top: 8px;">明日の予定</span>
      <span style="font-size: 22px;">09:30　顧客打ち合わせ</span>
      <span style="font-size: 18px;">他 2 件</span>
    </div>
  </div>
  <div style="position: absolute; left: 18px; right: 18px; bottom: 26px; display: flex; justify-content: space-between; border-top: 2px solid #000; padding-top: 6px; font-size: 18px;">
    <span>金 晴 22/12</span><span>土 曇 20/13</span><span>日 雨 18/12</span><span>月 晴 21/11</span><span>火 曇 20/12</span>
  </div>
{% else %}
  <div style="display: flex; flex-direction: column; gap: 6px;">
    {% assign sizes = "14,16,18,20,24,32" | split: "," %}
    {% for size in sizes %}
      <div style="display: flex; align-items: baseline; gap: 14px; white-space: nowrap; overflow: hidden;">
        <span style="width: 44px; flex: none; font: 14px 'Inter', sans-serif;">{{ size }}px</span>
        <span style="font-size: {{ size }}px;">千代田区 写真 誤差 直骨角 降水確率：終日（木）「議」</span>
      </div>
    {% endfor %}
    <div style="display: flex; gap: 16px; margin-top: 8px; font-size: 24px;">
      <span>ひらがな カタカナ 漢字 ABC 123</span>
    </div>
  </div>
{% endif %}
  <span class="meta">{{ label }} / {{ weight }} / {{ page }}</span>
</div>
