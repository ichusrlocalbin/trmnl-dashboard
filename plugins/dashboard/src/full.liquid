{% comment %}
  Portrait (480×800) dashboard, laid out like kindle-wallpaper-jp: tomorrow's weather fills the top
  half, large enough to read from across the room, with the events and the week below.

  weather_source and calendar_source are the plugins picked in the settings form. trmnlp nests their
  data under merge_variables, while TRMNL's docs show it at the top level, so both are accepted.
{% endcomment %}
{% assign weather = weather_source.merge_variables | default: weather_source %}
{% assign calendar = calendar_source.merge_variables | default: calendar_source %}
{% assign events = calendar.events %}
{% assign max_events = 5 %}
{% assign tomorrow = weather.days[1] %}

<div class="dash">
  <div class="hero">
    <div class="top">
      <span class="day">{{ tomorrow.date | date: "%-m/%-d" }}（{{ tomorrow.dow }}）</span>
      <span class="meta">気象庁 {{ weather.reported_at | date: "%-H時" }}発表</span>
    </div>
    <div class="main">
      {% render "weather_icon", icon: tomorrow.icon, size: 290 %}
      <div class="temps">
        <span class="k">最高</span>
        <span class="max">{{ tomorrow.temp_max | default: "-" }}<span class="deg">°</span></span>
        <span class="k">最低</span>
        <span class="min">{{ tomorrow.temp_min | default: "-" }}<span class="deg">°</span></span>
      </div>
    </div>
    <div class="bottom">
      <span class="text">{{ tomorrow.text }}</span>
      <span class="pop">降水 {{ tomorrow.pop | default: "-" }}%</span>
    </div>
  </div>

  <div class="events">
    <span class="h">予定:</span>
    {% comment %}
      A date / time / title table without rules, like kindle-wallpaper-jp. All-day events leave the
      time blank. Events are assumed to arrive sorted by start time, as the Google Calendar API
      returns them.
    {% endcomment %}
    {% assign dows = "日,月,火,水,木,金,土" | split: "," %}
    {% assign shown = 0 %}
    {% for event in events %}
      {% assign start = event.start.dateTime | default: event.start.date %}
      {% assign start_date = start | slice: 0, 10 %}
      {% if start_date >= weather.days[0].date and shown < max_events %}
        {% assign shown = shown | plus: 1 %}
        {% assign dow = start_date | date: "%w" | plus: 0 %}
        <span class="e"><span class="date">{{ start_date | date: "%-m/%-d" }}（{{ dows[dow] }}）</span><span class="time">{% if event.start.dateTime %}{{ event.start.dateTime | date: "%-H:%M" }}{% endif %}</span><span class="title">{{ event.summary }}</span></span>
      {% endif %}
    {% endfor %}
    {% if shown == 0 %}<span class="e">予定なし</span>{% endif %}
  </div>

  <div class="week">
    {% for day in weather.week offset: 1 limit: 6 %}
      <div class="d">
        <span class="dow">{{ day.dow }}</span>
        {% render "weather_icon", icon: day.icon, size: 56 %}
        <span class="tt">{{ day.temp_max | default: "-" }}/{{ day.temp_min | default: "-" }}</span>
      </div>
    {% endfor %}
  </div>
</div>
