{% comment %}
  Portrait (480×800) dashboard, laid out like kindle-wallpaper-jp: tomorrow's weather fills the top
  half, large enough to read from across the room, with the events and the week below.
{% endcomment %}
{% assign weather = private_plugin_1.merge_variables %}
{% assign events = google_calendar_1.merge_variables.events %}
{% assign tomorrow = weather.days[1] %}

<div class="dash">
  <div class="hero">
    <div class="top">
      <span class="day">明日 {{ tomorrow.date | date: "%-m/%-d" }}（{{ tomorrow.dow }}）</span>
      <span class="meta">気象庁 {{ weather.reported_at | date: "%-H時" }}発表</span>
    </div>
    <div class="main">
      {% render "weather_icon", icon: tomorrow.icon, size: 280 %}
      <div class="temps">
        <span class="k">最高</span>
        <span class="max">{{ tomorrow.temp_max | default: "-" }}<span class="deg">°</span></span>
        <span class="k">最低</span>
        <span class="min">{{ tomorrow.temp_min | default: "-" }}<span class="deg">°</span></span>
      </div>
    </div>
    <div class="bottom">
      <span class="text">{{ tomorrow.text }}</span>
      <span class="pop">降水 {{ tomorrow.pop | default: "-" }}%</span>
    </div>
  </div>

  <div class="rule"></div>
  <div class="events">
    {% for day in weather.days limit: 2 %}
      <span class="h">{{ day.label }}の予定</span>
      {% assign count = 0 %}
      {% for event in events %}
        {% assign start = event.start.dateTime | default: event.start.date %}
        {% if start contains day.date %}
          {% assign count = count | plus: 1 %}
          {% if count <= 3 %}<span class="e"><span class="time">{% if event.start.dateTime %}{{ event.start.dateTime | slice: 11, 5 }}{% else %}終日{% endif %}</span>{{ event.summary }}</span>{% endif %}
        {% endif %}
      {% endfor %}
      {% if count == 0 %}<span class="e">予定なし</span>{% elsif count > 3 %}<span class="e">　　　　他 {{ count | minus: 3 }} 件</span>{% endif %}
    {% endfor %}
  </div>

  <div class="rule"></div>
  <div class="week">
    {% for day in weather.week offset: 1 limit: 5 %}
      <div class="d">
        <span class="dow">{{ day.dow }}</span>
        {% render "weather_icon", icon: day.icon, size: 60 %}
        <span class="tt">{{ day.temp_max | default: "-" }}/{{ day.temp_min | default: "-" }}</span>
      </div>
    {% endfor %}
  </div>
</div>
