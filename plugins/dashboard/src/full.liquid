{% comment %}
  Landscape (800×480) dashboard. The day's weather (today until 11:00, then tomorrow) fills the left
  half, large enough to read from across the room, like kindle-wallpaper-jp; the events, the next
  24 hours (3-hourly) and the week are stacked on the right.

  weather_source and calendar_source are the plugins picked in the settings form. Each may hold the
  plugin's data or only its name (e.g. private_plugin_523418), in which case the data is looked up by
  that name. A private plugin's data sits under merge_variables; a native plugin's at the top level.
{% endcomment %}
{% assign weather = weather_source %}
{% assign kind = weather_source | json | slice: 0 %}
{% if kind == '"' %}{% assign weather = [weather_source] %}{% endif %}
{% if weather.merge_variables %}{% assign weather = weather.merge_variables %}{% endif %}
{% assign calendar = calendar_source %}
{% assign kind = calendar_source | json | slice: 0 %}
{% if kind == '"' %}{% assign calendar = [calendar_source] %}{% endif %}
{% if calendar.merge_variables %}{% assign calendar = calendar.merge_variables %}{% endif %}
{% assign events = calendar.events %}
{% assign max_events = 5 %}
{% comment %}
  The local time, in the user's time zone on TRMNL. date reads a number as seconds in UTC, so the
  offset is added first.
{% endcomment %}
{% assign local = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset %}
{% assign hour = local | modulo: 86400 | divided_by: 3600 %}
{% assign today = local | date: "%Y-%m-%d" %}
{% if hour < 11 %}{% assign hero_date = today %}{% else %}{% assign hero_date = local | plus: 86400 | date: "%Y-%m-%d" %}{% endif %}
{% assign hero = weather.days | where: "date", hero_date | first | default: weather.days[1] %}

{% if trmnl.plugin_settings.custom_fields_values.debug == "yes" %}
  {% comment %} Shows what the merged plugins actually hand over, to fit the template to it. {% endcomment %}
  <pre style="font-size: 10px; white-space: pre-wrap; word-break: break-all; margin: 8px;">settings: {{ trmnl.plugin_settings.custom_fields_values | json }}
weather_source: {{ weather_source | json | truncate: 900 }}
calendar_source: {{ calendar_source | json | truncate: 1500 }}</pre>
{% else %}
<div class="dash">
  <div class="hero">
    <div class="top">
      <span class="day">{{ hero.date | date: "%-m/%-d" }}（{{ hero.dow }}）</span>
      <span class="meta">気象庁 {{ weather.reported_at | date: "%-H時" }}発表</span>
    </div>
    <div class="main">
      {% render "weather_icon", icon: hero.icon, size: 266 %}
      <div class="temps">
        <span class="k">最高</span>
        <span class="max">{{ hero.temp_max | default: "-" }}<span class="deg">°</span></span>
        <span class="k">最低</span>
        <span class="min">{{ hero.temp_min | default: "-" }}<span class="deg">°</span></span>
      </div>
    </div>
    <div class="bottom">
      <span class="text">{{ hero.text }}</span>
      <span class="pop">降水 {{ hero.pop | default: "-" }}%</span>
    </div>
  </div>

  <div class="side">
  <div class="events">
    <span class="h">予定:</span>
    {% comment %}
      A date / time / title table without rules, like kindle-wallpaper-jp. All-day events leave the
      time blank. The TRMNL Google Calendar plugin sends events sorted by start time, each with
      summary, all_day and start_full (e.g. 2026-10-30T12:00:00.000+09:00).
    {% endcomment %}
    {% assign dows = "日,月,火,水,木,金,土" | split: "," %}
    {% assign shown = 0 %}
    {% for event in events %}
      {% assign start_date = event.start_full | slice: 0, 10 %}
      {% if start_date >= today and event.status != "cancelled" and shown < max_events %}
        {% assign shown = shown | plus: 1 %}
        {% assign dow = start_date | date: "%w" | plus: 0 %}
        <span class="e"><span class="date">{{ start_date | date: "%-m/%-d" }}（{{ dows[dow] }}）</span><span class="time">{% unless event.all_day %}{{ event.start_full | date: "%-H:%M" }}{% endunless %}</span><span class="title">{{ event.summary }}</span></span>
      {% endif %}
    {% endfor %}
    {% if shown == 0 %}<span class="e">予定なし</span>{% endif %}
  </div>

  <div class="hours">
    {% for slot in weather.hours %}
      <div class="s">
        <span class="hh">{{ slot.hour }}時</span>
        {% render "weather_icon", icon: slot.icon, size: 32 %}
        <span class="ht">{{ slot.temp | default: "-" }}°</span>
      </div>
    {% endfor %}
  </div>

  <div class="week">
    {% for day in weather.week offset: 1 limit: 6 %}
      <div class="d">
        <span class="dow">{{ day.dow }}</span>
        {% render "weather_icon", icon: day.icon, size: 46 %}
        <span class="tt">{{ day.temp_max | default: "-" }}/{{ day.temp_min | default: "-" }}</span>
      </div>
    {% endfor %}
  </div>
  </div>
</div>
{% endif %}
