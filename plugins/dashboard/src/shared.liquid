{% comment %}
  Shared by every view: fonts, styles, and the weather icons.

  Icons are line drawings, which stay clean on a 1-bit screen without the weight of solid black.
  weather_icon composes them from the { base, change, to } that jma-weather produces.
{% endcomment %}
<link rel="stylesheet" href="https://trmnl.com/fonts/fallbacks-ja.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=block">
<style>
  .dash { position: relative; width: 100%; height: 100%; padding: 16px 20px; box-sizing: border-box; display: flex; flex-direction: column; color: #000; font-family: 'BIZ UDPGothic', 'Inter Variable', 'Inter', sans-serif; }
  .dash .b { font-weight: 700; }
  .dash .rule { border-top: 3px solid #000; }
  .dash .hero { display: flex; flex-direction: column; padding-bottom: 6px; }
  .dash .hero .top { display: flex; justify-content: space-between; align-items: baseline; }
  .dash .hero .day { font-size: 34px; font-weight: 700; }
  .dash .hero .meta { font-size: 14px; }
  .dash .hero .main { display: flex; align-items: center; justify-content: space-between; }
  .dash .hero .temps { display: flex; flex-direction: column; align-items: flex-start; padding-right: 4px; }
  .dash .hero .k { font-size: 22px; line-height: 1; }
  .dash .hero .max { font-size: 100px; font-weight: 700; line-height: 1; }
  .dash .hero .min { font-size: 80px; line-height: 1; }
  .dash .hero .deg { font-size: 0.6em; vertical-align: top; }
  .dash .hero .bottom { display: flex; justify-content: space-between; align-items: baseline; }
  .dash .hero .text { font-size: 26px; }
  .dash .hero .pop { font-size: 30px; font-weight: 700; }
  .dash .events { flex: 1; min-height: 0; padding: 6px 0; display: flex; flex-direction: column; overflow: hidden; }
  .dash .events > span { flex: none; line-height: 1.3; }
  .dash .events .h { font-size: 18px; font-weight: 700; margin-bottom: 2px; }
  .dash .events .e { font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dash .events .e { display: flex; }
  .dash .events .e .date { flex: none; width: 104px; }
  .dash .events .e .time { flex: none; width: 56px; margin-right: 10px; }
  .dash .events .e .title { overflow: hidden; text-overflow: ellipsis; }
  .dash .week { display: flex; justify-content: space-between; padding-top: 8px; }
  .dash .week .d { display: flex; flex-direction: column; align-items: center; width: 84px; gap: 2px; }
  .dash .week .dow { font-size: 20px; font-weight: 700; }
  .dash .week .tt { font-size: 18px; }
  .wx { display: block; flex: none; }
</style>

<svg width="0" height="0" style="position: absolute;">
  <defs>
    <symbol id="wx-sunny" viewBox="0 0 100 100">
      <g fill="none" stroke="#000" stroke-width="5" stroke-linecap="round">
        <circle cx="50" cy="50" r="19"/>
        <line x1="50" y1="9" x2="50" y2="20"/><line x1="50" y1="80" x2="50" y2="91"/>
        <line x1="9" y1="50" x2="20" y2="50"/><line x1="80" y1="50" x2="91" y2="50"/>
        <line x1="21" y1="21" x2="29" y2="29"/><line x1="71" y1="71" x2="79" y2="79"/>
        <line x1="79" y1="21" x2="71" y2="29"/><line x1="21" y1="79" x2="29" y2="71"/>
      </g>
    </symbol>
    <symbol id="wx-cloud-shape" viewBox="0 0 100 100">
      <path d="M27 76 A15 15 0 0 1 29 46.2 A23 23 0 0 1 72 44 A16 16 0 0 1 75 76 Z"
            fill="#fff" stroke="#000" stroke-width="5" stroke-linejoin="round"/>
    </symbol>
    <symbol id="wx-cloudy" viewBox="0 0 100 100">
      <use href="#wx-cloud-shape" x="0" y="-4" width="100" height="100"/>
    </symbol>
    <symbol id="wx-rain" viewBox="0 0 100 100">
      <use href="#wx-cloud-shape" x="0" y="-18" width="100" height="100"/>
      <g stroke="#000" stroke-width="5" stroke-linecap="round">
        <line x1="36" y1="68" x2="30" y2="86"/><line x1="52" y1="68" x2="46" y2="86"/><line x1="68" y1="68" x2="62" y2="86"/>
      </g>
    </symbol>
    <symbol id="wx-snow" viewBox="0 0 100 100">
      <use href="#wx-cloud-shape" x="0" y="-18" width="100" height="100"/>
      <g fill="none" stroke="#000" stroke-width="4.5" stroke-linecap="round">
        <circle cx="32" cy="78" r="5"/><circle cx="50" cy="86" r="5"/><circle cx="68" cy="78" r="5"/>
      </g>
    </symbol>
  </defs>
</svg>

{% template weather_icon %}
  {% comment %} Newspaper weather marks: "/" for のち (later), "|" for 時々・一時 (sometimes). {% endcomment %}
  <svg class="wx" width="{{ size }}" height="{{ size }}" viewBox="0 0 100 100">
    {% if icon.change == "later" %}
      <use href="#wx-{{ icon.base }}" x="0" y="0" width="56" height="56"/>
      <line x1="30" y1="78" x2="78" y2="30" stroke="#000" stroke-width="4" stroke-linecap="round"/>
      <use href="#wx-{{ icon.to }}" x="44" y="44" width="56" height="56"/>
    {% elsif icon.change == "sometimes" %}
      <use href="#wx-{{ icon.base }}" x="0" y="25" width="48" height="48"/>
      <line x1="50" y1="30" x2="50" y2="70" stroke="#000" stroke-width="4" stroke-linecap="round"/>
      <use href="#wx-{{ icon.to }}" x="52" y="25" width="48" height="48"/>
    {% else %}
      <use href="#wx-{{ icon.base }}" x="0" y="0" width="100" height="100"/>
    {% endif %}
  </svg>
{% endtemplate %}
