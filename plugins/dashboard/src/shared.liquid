{% comment %}
  Shared by every view: fonts, styles, and the weather icons.

  Clouds and thunder come from kindle-wallpaper-jp. Rain is an umbrella and snow a snowman, as in
  JMA's icons. Heavy rain and snow, and thunder, are filled in.
  weather_icon composes them from the { base, change, to } that jma-weather produces.
{% endcomment %}
<link rel="stylesheet" href="https://trmnl.com/fonts/fallbacks-ja.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=block">
<style>
  .dash { position: relative; width: 100%; height: 100%; padding: 16px 24px 18px 20px; box-sizing: border-box; display: flex; gap: 28px; color: #000; font-family: 'BIZ UDPGothic', 'Inter Variable', 'Inter', sans-serif; }
  .dash .b { font-weight: 700; }
  .dash .hero { flex: none; width: 410px; display: flex; flex-direction: column; justify-content: space-between; }
  .dash .hero .top { display: flex; justify-content: space-between; align-items: baseline; }
  .dash .hero .day { font-size: 34px; font-weight: 700; }
  .dash .hero .meta { font-size: 14px; }
  .dash .hero .main { display: flex; align-items: center; justify-content: space-between; }
  .dash .hero .temps { display: flex; flex-direction: column; align-items: flex-start; }
  .dash .hero .k { font-size: 22px; line-height: 1; }
  .dash .hero .max + .k { margin-top: 18px; }
  .dash .hero .max { font-size: 80px; font-weight: 700; line-height: 1; }
  .dash .hero .min { font-size: 80px; line-height: 1; align-self: flex-end; }
  .dash .hero .deg { font-size: 0.6em; vertical-align: top; }
  .dash .hero .bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; }
  .dash .hero .text { flex: 1; min-width: 0; font-size: 22px; line-height: 1.3; word-break: keep-all; }
  .dash .hero .pop { flex: none; font-size: 30px; font-weight: 700; }
  .dash .side { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .dash .events { flex: 1; min-height: 0; padding-top: 8px; display: flex; flex-direction: column; overflow: hidden; }
  .dash .events > span { flex: none; line-height: 1.3; }
  .dash .events .e + .e { margin-top: 13px; }
  .dash .events .h { font-size: 18px; font-weight: 700; margin-bottom: 18px; }
  .dash .events .e { font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dash .events .e { display: flex; }
  .dash .events .e .date { flex: none; width: 106px; }
  .dash .events .e .time { flex: none; width: 46px; margin-right: 10px; font-size: 15px; text-align: right; font-variant-numeric: tabular-nums; }
  .dash .events .e .title { overflow: hidden; text-overflow: ellipsis; }
  .dash .week { display: flex; justify-content: space-between; }
  .dash .week .d { display: flex; flex-direction: column; align-items: center; width: 48px; gap: 4px; }
  .dash .week .dow { font-size: 18px; font-weight: 700; }
  .dash .week .tt { font-size: 14px; }
  .wx { display: block; flex: none; }
</style>

{% comment %} Icons from kindle-wallpaper-jp (CC BY 4.0), see ../icons/kindle-wallpaper-jp/README.md. {% endcomment %}
<svg width="0" height="0" style="position: absolute;">
  <defs>
    <!-- Outlined sun (800d.svg is a filled disc, too heavy on the screen) -->
    <symbol id="wx-sunny" viewBox="0 0 100 100">
      <g fill="none" stroke="#000" stroke-width="4" stroke-linecap="round">
        <circle cx="50" cy="50" r="20"/>
        <line x1="50" y1="8" x2="50" y2="20"/><line x1="50" y1="80" x2="50" y2="92"/>
        <line x1="8" y1="50" x2="20" y2="50"/><line x1="80" y1="50" x2="92" y2="50"/>
        <line x1="20" y1="20" x2="29" y2="29"/><line x1="71" y1="71" x2="80" y2="80"/>
        <line x1="80" y1="20" x2="71" y2="29"/><line x1="20" y1="80" x2="29" y2="71"/>
      </g>
    </symbol>
    <!-- 500d.svg without the rain (cloudy) -->
    <symbol id="wx-cloudy" viewBox="0 -16 100 100"><path d="M51.188,6.8125c-12.627,0-22.762,10.028-23.5,22.468-6.17,0.593-10.961,5.238-12.063,11.25-0.362-0.038-0.648-0.156-1.031-0.156-6.7074,0-12.219,5.485-12.219,12.187,0,3.353,1.5923,6.174,3.9375,7.75,2.3476,1.577,5.2555,2.094,8.2815,2.094h31.156,16.969,15.625c10.619,0,19.281-8.66,19.281-19.281s-8.66-19.281-19.281-19.281c-1.612,0-3.065,0.434-4.532,0.812-2.683-10.171-11.627-17.844-22.624-17.844zm0,4.5315c9.607,0,17.453,7.119,18.906,16.312l0.437,2.75,2.625-1.062c1.65-0.626,3.378-0.938,5.188-0.938,8.171,0,14.75,6.55,14.75,14.719,0,8.171-6.579,14.719-14.75,14.719h-15.625-16.969-31.156c-2.455,0-4.507-0.508-5.7502-1.344-1.2429-0.833-1.9376-1.809-1.9376-3.938,0-4.249,3.4328-7.656,7.6878-7.656,0.705,0,1.37,0.14,2.156,0.375l2.969,0.907v-3.063c0-0.14-0.056-0.14-0.063-0.219,0-0.128-0.012-0.127,0-0.156-0.002-0.012,0.002-0.058,0-0.062,0.119-5.058,4.196-9.094,9.282-9.094-0.074,0,0.173,0.058,0.687,0.094l2.531,0.124-0.094-2.531c-0.028-0.621-0.156-0.801-0.156-0.656,0-10.645,8.629-19.281,19.282-19.281z"/></symbol>
    <!-- 211d.svg (thunder) -->
    <symbol id="wx-thunder" viewBox="0 0 100 100"><path d="M51.312,3.5625c-13.094,0-23.718,10.63-23.718,23.718,0,0.296,0.08,0.548,0.094,0.844-0.296-0.02-0.58-0.063-0.876-0.063-7.044,0-12.75,5.706-12.75,12.75,0,0.088,0.032,0.164,0.032,0.25-1.008-0.302-2.054-0.5-3.156-0.5-6.0435,0-10.938,4.901-10.938,10.938,0,6.043,4.8945,8.312,10.938,8.312h70.312c10.358,0,18.75-8.39,18.75-18.75,0-10.358-8.391-18.75-18.75-18.75-2.34,0-4.568,0.502-6.625,1.282-1.788-11.321-11.495-20.032-23.313-20.032zm-4.593,58.656l-11.969,20.531h8.562l-6.843,13.688,20.531-20.532h-10.281l8.562-13.687h-8.562zm-23.25,3.781l-9.031,24.812,1.937,0.719,9.313-25.531h-2.219zm10.343,0l-9.031,24.812,1.938,0.719,9.281-25.531h-2.188zm30.969,0l-9.031,24.812,1.938,0.719,9.281-25.531h-2.188zm10.313,0l-9,24.812,1.937,0.719,9.281-25.531h-2.218z"/></symbol>
    <!-- Umbrella and snowman, as in JMA's icons; filled in for heavy rain and snow -->
    <symbol id="wx-umbrella-shape" viewBox="0 0 100 100">
      <path d="M12 50 A38 36 0 0 1 88 50 A12.7 9 0 0 0 62.7 50 A12.7 9 0 0 0 37.3 50 A12.7 9 0 0 0 12 50 Z"
            stroke="#000" stroke-width="5" stroke-linejoin="round"/>
      <g fill="none" stroke="#000" stroke-width="5" stroke-linecap="round">
        <line x1="50" y1="8" x2="50" y2="14"/>
        <path d="M50 50 V80 A8 8 0 0 1 34 80"/>
      </g>
    </symbol>
    <symbol id="wx-rain" viewBox="0 0 100 100">
      <use href="#wx-umbrella-shape" fill="#fff" x="0" y="0" width="100" height="100"/>
    </symbol>
    <symbol id="wx-heavy_rain" viewBox="0 0 100 100">
      <use href="#wx-umbrella-shape" fill="#000" x="0" y="0" width="100" height="100"/>
      <g stroke="#000" stroke-width="4" stroke-linecap="round">
        <line x1="70" y1="64" x2="64" y2="80"/><line x1="84" y1="62" x2="78" y2="78"/><line x1="78" y1="82" x2="74" y2="93"/>
      </g>
    </symbol>
    <symbol id="wx-snowman-shape" viewBox="0 0 100 100">
      <g fill="none" stroke="#000" stroke-width="4.5" stroke-linecap="round">
        <line x1="29" y1="62" x2="13" y2="50"/><line x1="71" y1="62" x2="87" y2="50"/>
      </g>
      <g stroke="#000" stroke-width="4.5" stroke-linejoin="round">
        <circle cx="50" cy="69" r="23"/>
        <circle cx="50" cy="36" r="14"/>
        <path d="M38 25 L41 9 H59 L62 25 Z"/>
      </g>
    </symbol>
    <symbol id="wx-snow" viewBox="0 0 100 100">
      <use href="#wx-snowman-shape" fill="#fff" x="0" y="0" width="100" height="100"/>
      <g fill="#000"><circle cx="45" cy="35" r="2.8"/><circle cx="55" cy="35" r="2.8"/></g>
    </symbol>
    <symbol id="wx-heavy_snow" viewBox="0 0 100 100">
      <use href="#wx-snowman-shape" fill="#000" x="0" y="0" width="100" height="100"/>
      <g fill="#fff"><circle cx="45" cy="35" r="2.8"/><circle cx="55" cy="35" r="2.8"/></g>
    </symbol>
  </defs>
</svg>

{% template weather_icon %}
  {% comment %} Newspaper weather marks: "/" for のち (later), "|" for 時々・一時 (sometimes). {% endcomment %}
  <svg class="wx" width="{{ size }}" height="{{ size }}" viewBox="0 0 100 100">
    {% if icon.change == "later" %}
      <use href="#wx-{{ icon.base }}" x="0" y="0" width="56" height="56"/>
      <line x1="30" y1="78" x2="78" y2="30" stroke="#000" stroke-width="4" stroke-linecap="round"/>
      <use href="#wx-{{ icon.to }}" x="44" y="44" width="56" height="56"/>
    {% elsif icon.change == "sometimes" %}
      {% comment %} The occasional weather is drawn smaller, so 時々 reads at a glance. {% endcomment %}
      <use href="#wx-{{ icon.base }}" x="0" y="18" width="62" height="62"/>
      <line x1="64" y1="34" x2="64" y2="76" stroke="#000" stroke-width="4" stroke-linecap="round"/>
      <use href="#wx-{{ icon.to }}" x="66" y="46" width="34" height="34"/>
    {% else %}
      <use href="#wx-{{ icon.base }}" x="0" y="0" width="100" height="100"/>
    {% endif %}
  </svg>
{% endtemplate %}
