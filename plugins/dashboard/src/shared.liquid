{% comment %}
  Shared by every view: fonts, styles, and the weather icons.

  Icons are drawn as solid black shapes, which stay clean on a 1-bit screen and read from across a
  room. weather_icon composes them from the { base, change, to } that jma-weather produces:
  "later" (のち) draws base → to, "sometimes" (時々) draws base with a smaller to in the corner.
{% endcomment %}
<link rel="stylesheet" href="https://trmnl.com/fonts/fallbacks-ja.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=block">
<style>
  .dash { position: relative; width: 100%; height: 100%; padding: 16px 20px; box-sizing: border-box; display: flex; flex-direction: column; color: #000; font-family: 'BIZ UDPGothic', 'Inter Variable', 'Inter', sans-serif; }
  .dash .b { font-weight: 700; }
  .dash .rule { border-top: 3px solid #000; }
  .dash .hero { display: flex; flex-direction: column; align-items: center; padding: 4px 0 8px; }
  .dash .hero .day { font-size: 36px; font-weight: 700; }
  .dash .hero .temps { font-size: 64px; line-height: 1; margin-top: 2px; }
  .dash .hero .temps .min { font-size: 44px; }
  .dash .hero .sub { font-size: 30px; margin-top: 4px; }
  .dash .hero .text { font-size: 22px; margin-top: 4px; }
  .dash .today { display: flex; align-items: center; gap: 14px; padding: 8px 0; }
  .dash .today .t1 { font-size: 24px; }
  .dash .today .t2 { font-size: 18px; display: flex; justify-content: space-between; }
  .dash .today .meta { font-size: 14px; }
  .dash .events { flex: 1; min-height: 0; padding: 6px 0; display: flex; flex-direction: column; overflow: hidden; }
  .dash .events > span { flex: none; line-height: 1.3; }
  .dash .events .h { font-size: 20px; font-weight: 700; margin-top: 2px; }
  .dash .events .e { font-size: 22px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dash .events .e .time { display: inline-block; width: 84px; }
  .dash .week { display: flex; justify-content: space-between; padding-top: 8px; }
  .dash .week .d { display: flex; flex-direction: column; align-items: center; width: 84px; gap: 2px; }
  .dash .week .dow { font-size: 20px; font-weight: 700; }
  .dash .week .tt { font-size: 18px; }
  .wx { display: block; }
</style>

<svg width="0" height="0" style="position: absolute;">
  <defs>
    <symbol id="wx-sunny" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="21" fill="#000"/>
      <g stroke="#000" stroke-width="8" stroke-linecap="round">
        <line x1="50" y1="8" x2="50" y2="19"/><line x1="50" y1="81" x2="50" y2="92"/>
        <line x1="8" y1="50" x2="19" y2="50"/><line x1="81" y1="50" x2="92" y2="50"/>
        <line x1="20" y1="20" x2="28" y2="28"/><line x1="72" y1="72" x2="80" y2="80"/>
        <line x1="80" y1="20" x2="72" y2="28"/><line x1="20" y1="80" x2="28" y2="72"/>
      </g>
    </symbol>
    <symbol id="wx-cloud-shape" viewBox="0 0 100 100">
      <g fill="#fff" stroke="#fff" stroke-width="10">
        <circle cx="34" cy="60" r="17"/><circle cx="56" cy="47" r="23"/><circle cx="76" cy="62" r="15"/>
        <rect x="17" y="60" width="74" height="17" rx="8.5"/>
      </g>
      <g fill="#000">
        <circle cx="34" cy="60" r="17"/><circle cx="56" cy="47" r="23"/><circle cx="76" cy="62" r="15"/>
        <rect x="17" y="60" width="74" height="17" rx="8.5"/>
      </g>
    </symbol>
    <symbol id="wx-cloudy" viewBox="0 0 100 100">
      <use href="#wx-cloud-shape" x="0" y="0" width="100" height="100"/>
    </symbol>
    <symbol id="wx-rain" viewBox="0 0 100 100">
      <use href="#wx-cloud-shape" x="0" y="-16" width="100" height="100"/>
      <g stroke="#000" stroke-width="8" stroke-linecap="round">
        <line x1="34" y1="74" x2="28" y2="90"/><line x1="54" y1="74" x2="48" y2="90"/><line x1="74" y1="74" x2="68" y2="90"/>
      </g>
    </symbol>
    <symbol id="wx-snow" viewBox="0 0 100 100">
      <use href="#wx-cloud-shape" x="0" y="-16" width="100" height="100"/>
      <g fill="#000">
        <circle cx="30" cy="82" r="6.5"/><circle cx="50" cy="90" r="6.5"/><circle cx="70" cy="82" r="6.5"/>
      </g>
    </symbol>
    <symbol id="wx-arrow" viewBox="0 0 100 100">
      <path d="M20 50 H72 M58 34 L76 50 L58 66" fill="none" stroke="#000" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
  </defs>
</svg>

{% template weather_icon %}
  {% assign half = size | times: 0.58 | round %}
  {% if icon.change == "later" %}
    <svg class="wx" width="{{ size | times: 1.5 | round }}" height="{{ size }}" viewBox="0 0 150 100">
      <use href="#wx-{{ icon.base }}" x="0" y="20" width="60" height="60"/>
      <use href="#wx-arrow" x="58" y="38" width="24" height="24"/>
      <use href="#wx-{{ icon.to }}" x="80" y="10" width="70" height="70"/>
    </svg>
  {% elsif icon.change == "sometimes" %}
    <svg class="wx" width="{{ size }}" height="{{ size }}" viewBox="0 0 100 100">
      <use href="#wx-{{ icon.base }}" x="0" y="0" width="78" height="78"/>
      <circle cx="74" cy="74" r="25" fill="#fff"/>
      <use href="#wx-{{ icon.to }}" x="52" y="52" width="46" height="46"/>
    </svg>
  {% else %}
    <svg class="wx" width="{{ size }}" height="{{ size }}" viewBox="0 0 100 100">
      <use href="#wx-{{ icon.base }}" x="0" y="0" width="100" height="100"/>
    </svg>
  {% endif %}
{% endtemplate %}
