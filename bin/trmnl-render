#!/bin/sh
# Renders a trmnlp plugin directory to PNG with the production-like renderer.
#
#   bin/trmnl-render <plugin-dir> [color-depth]   # color-depth: 1 (default) or 2
#
# Output goes to <plugin-dir>/_build/*.png. See bin/trmnlp for the environment variables it passes.
set -eu
exec "$(dirname "$0")/trmnlp" "${1:?usage: bin/trmnl-render <plugin-dir> [color-depth]}" build --png --color-depth "${2:-1}"
